# Supabase — pegar em: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# SECRETA (ignora RLS, acesso total ao banco). Server-only — NUNCA NEXT_PUBLIC.
# Usada só pelo cron de rastreio, que roda sem sessão de usuário.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Segredo do cron de rastreio. O Vercel Cron manda no header Authorization.
# Gere um valor aleatório forte (ex.: openssl rand -hex 32).
CRON_SECRET=

# Melhor Envio (OAuth 2.0) — criar app em:
#   https://melhorenvio.com.br/painel/gerenciar/tokens  (produção)
#   https://sandbox.melhorenvio.com.br/painel/gerenciar/tokens  (sandbox)
# Server-only: NUNCA prefixar com NEXT_PUBLIC.
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
# Redirect URI tem que bater EXATO com a registrada no app:
MELHOR_ENVIO_REDIRECT_URI=https://YOUR_DOMAIN/api/melhor-envio/callback
# "sandbox" (default, sem cobrança real) ou "production":
MELHOR_ENVIO_ENV=sandbox
# E-mail de contato exigido pela API no header User-Agent:
MELHOR_ENVIO_CONTACT_EMAIL=voce@exemplo.com
# CEP de origem padrão dos envios (de onde a HALO despacha). Usado como default
# na cotação de frete; opcional (dá pra digitar na hora). Só dígitos ou com hífen.
MELHOR_ENVIO_FROM_CEP=01310-100
